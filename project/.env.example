PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@projectbuddy.<YOUR_CLUSTER_ID>.mongodb.net/projectbuddy?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-email@example.com
SMTP_PASS=use-an-app-password-or-provider-smtp-password
EMAIL_FROM=ProjectBuddy <your-sending-email@example.com>
JWT_EXPIRE=7d
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
